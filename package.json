{
  "name": "skybridge-network",
  "private": true,
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "api": "dotnet watch --project src/SkyBridge.Api --launch-profile https",
    "web": "npm --prefix skybridge-web start -- --open",
    "dev": "concurrently -n api,web -c red,white \"npm run api\" \"wait-on --timeout 180000 tcp:localhost:5079 && npm run web\"",
    "test": "dotnet test && npm --prefix skybridge-web test -- --watch=false"
  },
  "keywords": [],
